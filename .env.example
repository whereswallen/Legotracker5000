# Database (SQLite file path)
DATABASE_PATH=./data/legotracker.db

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-secret-string

# Rebrickable API (optional - app works without it)
# Get a free key at https://rebrickable.com/api/
REBRICKABLE_API_KEY=

# Optional: OAuth providers
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
